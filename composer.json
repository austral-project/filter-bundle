{
    "name": "austral/filter-bundle",
    "type": "symfony-bundle",
    "description": "Builder and mapper to filter austral",
    "keywords": [
        "Austral",
        "Mapper",
        "Filter"
    ],
    "license": "MIT",
    "homepage": "https://austral.dev",
    "authors": [
        {
            "name": "Matthieu Beurel",
            "email": "matthieu@austral.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2 <9.0",
        "austral/tools-bundle": "^4.0",
        "austral/form-bundle": "^4.0",
        "austral/list-bundle": "^4.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Austral\\FilterBundle\\": ""
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
